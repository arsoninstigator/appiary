<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    <!-- no updatePeriodSeconds: it is the os's battery-hostile polling
         mechanism. this widget is snapshot-driven - refreshWidgets() nudges
         the provider the moment the app writes, and the home screen redraws
         on its own. (also: AAPT on compileSdk 36 rejects the attribute in
         library packaging - caught by a real gradle build, not by us.) -->
    android:initialLayout="@layout/appiary_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
