<?xml version="1.0" encoding="utf-8"?>
<!-- no updatePeriodSeconds: it is the os's battery-hostile polling
     mechanism, and aapt on compileSdk 36 rejects the attribute in library
     packaging anyway (caught by a real gradle build, not by us). this
     widget is snapshot-driven - refreshWidgets() nudges the provider the
     moment the app writes, and the home screen redraws on its own. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:initialLayout="@layout/appiary_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
